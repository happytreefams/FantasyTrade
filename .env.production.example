# Fantasy Trade — production environment variables (Vercel + Neon Postgres)
#
# This file documents every environment variable the production deployment
# needs and where each value comes from. It is NOT loaded automatically —
# copy the values into Vercel's Environment Variables settings (Project
# Settings → Environment Variables) for the Production environment. See
# DEPLOYMENT.md for the full walkthrough.
#
# `src/lib/env.ts` validates all of this at server boot (see
# `src/instrumentation.ts`) — a missing or malformed required value fails the
# deployment immediately with a clear message instead of an obscure runtime
# error later.

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------

# Neon dashboard → your project → "Connect" → "Pooled connection". Ends in
# `-pooler` before `.neon.tech` and includes `?sslmode=require`. This is what
# the running app uses for every query (via PgBouncer) — required.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Neon dashboard → same "Connect" panel → "Direct connection" (no `-pooler`
# in the host). Only `prisma migrate deploy` and `prisma db seed` use this —
# migrations need a direct, unpooled connection (see Prisma's Neon docs).
# The running app never reads this. Required for the build's migrate step.
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
# A stable, secret value — rotating it invalidates every existing session.
NEXTAUTH_SECRET="replace-with-openssl-rand--base64-32-output"

# The exact production URL, including https:// and no trailing slash — the
# final custom domain, not the *.vercel.app preview URL. Wrong/missing value
# here silently breaks sign-in redirects and cookie scoping.
NEXTAUTH_URL="https://your-custom-domain.com"

# ---------------------------------------------------------------------------
# Market data (Alpha Vantage) — optional; the app degrades to synthetic
# prices without it (see MarketDataProvider's null-on-failure contract)
# ---------------------------------------------------------------------------

# Free key: https://www.alphavantage.co/support/#api-key
MARKET_DATA_API_KEY="your_alpha_vantage_api_key"

# Free key: https://twelvedata.com/pricing (free tier: 800 requests/day, 8/minute)
# Used for daily EOD price fetching (see src/lib/market-data/providers/twelve-data.ts).
# Alpha Vantage above stays in use for fundamentals/news.
TWELVE_DATA_API_KEY="your_twelve_data_api_key"

# Optional overrides for the free tier's ~25 calls/day cap — only set these
# if you've upgraded past the free tier. Leave unset to use the default (25).
# MARKET_DATA_MAX_DAILY_CALLS="25"
# MARKET_DATA_MAX_WEEKLY_CALLS="25"

# ---------------------------------------------------------------------------
# Cron job protection
# ---------------------------------------------------------------------------

# Generate with: openssl rand -hex 32
# Protects /api/cron/*. Set this env var in Vercel and Vercel automatically
# sends it as `Authorization: Bearer <value>` to its own scheduled
# invocations (see vercel.json) — no further Vercel-side configuration
# needed. The admin dashboard's "Run job now" buttons read it server-side
# too (never exposed to the browser). See DEPLOYMENT.md for how to trigger
# a cron route manually with curl.
CRON_SECRET="replace-with-openssl-rand--hex-32-output"

# ---------------------------------------------------------------------------
# Set automatically by Vercel — do not set these yourself
# ---------------------------------------------------------------------------
# NODE_ENV=production
# VERCEL=1
# VERCEL_URL=<deployment-specific *.vercel.app hostname>
