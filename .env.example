# Postgres connection string (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://fantasytrade:fantasytrade@localhost:5432/fantasytrade?schema=public"

# NextAuth
# Generate a value with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Alpha Vantage API key, used by `pnpm job:daily-close` for real EOD prices.
# Get one free at https://www.alphavantage.co/support/#api-key — the job falls
# back to synthetic prices if this is missing or the free-tier quota is hit.
# Optional: MARKET_DATA_MAX_DAILY_CALLS overrides the free-tier daily cap (25).
MARKET_DATA_API_KEY="your_market_data_api_key_here"

# Everything below this line is only required in production (Vercel + Neon) —
# see .env.production.example for the full production reference and where
# each value comes from. Not needed for local dev with Docker Postgres.
#
# DIRECT_URL         — Neon's unpooled connection string, used only by
#                      `prisma migrate deploy`/`prisma db seed`.
# CRON_SECRET        — protects /api/cron/*. Generate with `openssl rand -hex 32`.
